---
name: sink
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r1, $r2
    %0:gpr = COPY $r1
    %1:gpr = COPY $r2
    %2:gpr = ADD_ri %0, 7
    JNE_ri %1, 0, %bb.2
    JMP %bb.1
  bb.1:
    $r0 = COPY %2
    RET implicit $r0
  bb.2:
    $r0 = MOV_ri 0
    RET implicit $r0
...
