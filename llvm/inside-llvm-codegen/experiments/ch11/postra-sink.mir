---
name: sink_after_ra
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r1, $r2
    renamable $r6 = COPY $r1
    JNE_ri $r2, 0, %bb.2
    JMP %bb.1
  bb.1:
    liveins: $r6
    $r0 = COPY $r6
    RET implicit $r0
  bb.2:
    $r0 = MOV_ri 0
    RET implicit $r0
...
