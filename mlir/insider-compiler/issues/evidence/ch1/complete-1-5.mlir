// 三个仿射映射将同一迭代坐标映射到输入与输出的元素下标。
#map0 = affine_map<(d0, d1, d2) -> (d0, d2)>
#map1 = affine_map<(d0, d1, d2) -> (d2, d1)>
#map2 = affine_map<(d0, d1, d2) -> (d0, d1)>
func.func @forward(%arg0: tensor<1x16xf32>) -> tensor<1x10xf32> {
  %cst = arith.constant dense<"0x000080BF000040BF000000BF000080BE000000000000803E0000003F0000403F0000803F0000A03F"> : tensor<1x10xf32>
  %cst_0 = arith.constant dense<""> : tensor<16x10xf32>
  // indexing_maps 和 iterator_types 是属性；ins 是输入，outs 提供初始累加张量。
  %0 = linalg.generic {
      indexing_maps = [#map0, #map1, #map2],
      iterator_types = ["parallel", "parallel", "reduction"]
    } ins(%arg0, %cst_0 : tensor<1x16xf32>, tensor<16x10xf32>)
      outs(%cst : tensor<1x10xf32>) {
  // 区域中的块参数分别表示本次迭代的两个输入元素与当前输出累加值；它们仍是 SSA 值。
  ^bb0(%arg1: f32, %arg2: f32, %arg3: f32):
  // 将两个输入元素相乘，再与当前累加值相加。
    %1 = arith.mulf %arg1, %arg2 : f32
    %2 = arith.addf %arg3, %1 : f32
  // 终结本区域的一次标量计算，把更新后的元素交回 linalg.generic。
    linalg.yield %2 : f32
  } -> tensor<1x10xf32>
  return %0 : tensor<1x10xf32>
}
