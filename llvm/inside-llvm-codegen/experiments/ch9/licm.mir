---
name: licm
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1
    liveins: $r1, $r2, $r3
    %0:gpr = COPY $r1
    %1:gpr = COPY $r2
    %2:gpr = COPY $r3
    %3:gpr = MOV_ri 0
    JMP %bb.1
  bb.1:
    successors: %bb.1, %bb.2
    %4:gpr = PHI %3, %bb.0, %6, %bb.1
    %5:gpr = MUL_rr %0, %1
    STW %5, %2, 0
    %6:gpr = ADD_ri %4, 1
    JSGT_ri %6, 9, %bb.2
    JMP %bb.1
  bb.2:
    $r0 = COPY %5
    RET implicit $r0
...
