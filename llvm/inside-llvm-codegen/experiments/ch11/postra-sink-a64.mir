# Minimal pattern also covered by llvm/test/CodeGen/AArch64/post-ra-machine-sink.mir.
---
name: sink_after_ra
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $w0, $w1
    $w1 = SUBSWri $w1, 1, 0, implicit-def $nzcv
    renamable $w19 = COPY killed $w0
    Bcc 11, %bb.1, implicit $nzcv
    B %bb.2
  bb.1:
    liveins: $w1, $w19
    $w0 = ADDWrr $w1, $w19
    RET $x0
  bb.2:
    $w0 = COPY $wzr
    RET $x0
...
