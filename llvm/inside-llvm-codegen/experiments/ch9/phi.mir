---
name: phi
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r1, $r2
    %0:gpr = COPY $r1
    %1:gpr = COPY $r2
    JNE_ri %1, 0, %bb.2
    JMP %bb.1
  bb.1:
    successors: %bb.3
    JMP %bb.3
  bb.2:
    successors: %bb.3
    JMP %bb.3
  bb.3:
    %2:gpr = PHI %0, %bb.1, %0, %bb.2
    $r0 = COPY %2
    RET implicit $r0
...
