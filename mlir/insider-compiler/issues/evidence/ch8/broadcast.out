module {
  func.func @broadcast(%arg0: tensor<4xf32>, %arg1: tensor<2x4xf32>) -> tensor<2x4xf32> {
    %0 = tosa.reshape %arg0 {new_shape = array<i64: 1, 4>} : (tensor<4xf32>) -> tensor<1x4xf32>
    %1 = tosa.add %0, %arg1 : (tensor<1x4xf32>, tensor<2x4xf32>) -> tensor<2x4xf32>
    return %1 : tensor<2x4xf32>
