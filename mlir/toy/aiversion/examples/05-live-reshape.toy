# Teaching example of a lowering boundary, not a supported runtime reshape.
# Toy MLIR generation is expected to succeed.
# Affine lowering is expected to reject the live, non-identity toy.reshape.
# These expectations are source-derived, not results of an executed test.
def main() {
  var a = [[1, 2, 3], [4, 5, 6]];
  var t = transpose(a);
  var b<2, 3> = t;
  print(b);
}
